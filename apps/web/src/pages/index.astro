---
import Layout from '../layouts/Layout.astro';
import { Protected } from '../components/layout/Protected';
import { AppShell } from '../components/layout/AppShell';
---

<Layout titleKey="title.home">
  <Protected client:load>
    <AppShell client:load>
      <h1 class="text-2xl font-semibold text-fg-primary" data-i18n="home.heading">Panel de operaciones</h1>
      <p class="mt-2 text-fg-secondary" data-i18n="home.description">Bienvenido al sistema interno de iJac.</p>
    </AppShell>
  </Protected>
</Layout>
