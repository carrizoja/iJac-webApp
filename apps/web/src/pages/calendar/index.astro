---
import Layout from '../../layouts/Layout.astro';
import { Protected } from '../../components/layout/Protected';
import { AppShell } from '../../components/layout/AppShell';
import { CalendarView } from '../../components/calendar/CalendarView';
import { CalendarConnection } from '../../components/calendar/CalendarConnection';
---

<Layout title="Calendario | iJac Operations">
  <Protected client:load>
    <AppShell client:load>
      <h1 class="text-2xl font-semibold text-fg-primary">Calendario</h1>
      <p class="mt-2 text-fg-muted">Visualiza las órdenes por fecha de vencimiento.</p>
      <div class="mt-6">
        <CalendarConnection client:load />
      </div>
      <div class="mt-6">
        <CalendarView client:load />
      </div>
    </AppShell>
  </Protected>
</Layout>