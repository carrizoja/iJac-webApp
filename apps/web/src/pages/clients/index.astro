---
import Layout from '../../layouts/Layout.astro';
import { Protected } from '../../components/layout/Protected';
import { AppShell } from '../../components/layout/AppShell';
import { ClientManager } from '../../components/clients/ClientManager';
---

<Layout title="Clientes | iJac Operations">
  <Protected client:load>
    <AppShell client:load>
      <h1 class="text-2xl font-semibold text-slate-100">Clientes</h1>
      <p class="mt-2 text-slate-400">Gestiona los clientes de iJac.</p>
      <div class="mt-6">
        <ClientManager client:load />
      </div>
    </AppShell>
  </Protected>
</Layout>
