---
import Layout from '../../layouts/Layout.astro';
import { Protected } from '../../components/layout/Protected';
import { AppShell } from '../../components/layout/AppShell';
import { ClientManager } from '../../components/clients/ClientManager';
---

<Layout titleKey="title.clients">
  <Protected client:load>
    <AppShell client:load>
      <div class="space-y-6" data-testid="clients-page">
        <nav class="flex items-center gap-2 text-sm text-fg-tertiary" aria-label="Ruta de navegación" data-i18n-attr="aria-label:clients.breadcrumb">
          <a href="/" class="transition-colors hover:text-accent-brand" data-i18n="nav.home">Inicio</a>
          <span aria-hidden="true">›</span>
          <span class="text-fg-primary" aria-current="page" data-i18n="nav.clients">Clientes</span>
        </nav>

        <div>
          <h1 class="text-2xl font-semibold text-fg-primary" data-i18n="clients.pageHeading">Clientes</h1>
          <p class="mt-2 text-fg-secondary" data-i18n="clients.pageDescription">Contactos, organizaciones y notas de tus clientes.</p>
        </div>

        <section class="clients-workspace rounded-2xl border border-border-default bg-bg-secondary/80 p-4 sm:p-6" aria-labelledby="clients-workspace-heading">
          <h2 id="clients-workspace-heading" class="sr-only" data-i18n="clients.workspace">Directorio de clientes</h2>
          <ClientManager client:load />
        </section>
      </div>
    </AppShell>
  </Protected>
</Layout>
