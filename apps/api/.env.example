PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:4321
WEB_APP_URL=http://localhost:4321
ALLOWED_DOMAIN=example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional local service-account pair. Set both or neither; Cloud Run uses ADC.
FIREBASE_CLIENT_EMAIL=service-account@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
FIRESTORE_EMULATOR_HOST=localhost:8080
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/connection/oauth/callback
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
REPOSITORY_MODE=global
DEFAULT_ORGANIZATION_ID=
